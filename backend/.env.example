# Backend Environment File
# Copy to .env and update values

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# YOLOv8 Configuration
YOLO_CONFIDENCE=0.5
YOLO_IOU=0.45
YOLO_DEVICE=cpu
# For GPU: YOLO_DEVICE=0 (device index)

# Tracking
TRACKER_MAX_DISTANCE=50
TRACKER_MAX_AGE=30
TRACKER_MATCH_THRESHOLD=0.7

# OCR
OCR_GPU=false
MIN_PLATE_CONFIDENCE=0.3

# Video Processing
FRAME_SKIP=2
LINE_CROSS_DISTANCE=50

# Database
DATABASE_URL=sqlite:///./vehicle_intelligence.db

# Logging
LOG_LEVEL=INFO
